<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.quistock.quistock.presentation.splash.SplashFragment"
        android:label="@string/app_name">
        <action
            android:id="@+id/action_splashFragment_to_onboardingFragment"
            app:destination="@id/onboardingFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.quistock.quistock.presentation.onboarding.OnboardingFragment"
        android:label="@string/onboarding_welcome">
        <action
            android:id="@+id/action_onboardingFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/onboardingFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.quistock.quistock.presentation.login.LoginFragment"
        android:label="@string/Login">

        <action
            android:id="@+id/action_loginFragment_to_cadastroPessoalFragment"
            app:destination="@id/cadastroPessoalFragment" />

        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.quistock.quistock.presentation.home.HomeFragment"
        android:label="@string/home">
        <action
            android:id="@+id/action_homeFragment_to_interferencesFragment"
            app:destination="@id/interferencesFragment" />
        <action
            android:id="@+id/action_homeFragment_to_orderFragment"
            app:destination="@id/orderFragment" />
        <action
            android:id="@+id/action_homeFragment_to_promotionFragment"
            app:destination="@id/promotionFragment" />
        <action
            android:id="@+id/action_homeFragment_to_productControlFragment"
            app:destination="@id/productControlFragment" />
        <action
            android:id="@+id/action_homeFragment_to_employeeFragment"
            app:destination="@id/employeeFragment" />

        <action
            android:id="@+id/action_homeFragment_to_chatbotFragment"
            app:destination="@id/chatbotFragment" />
        <action
            android:id="@+id/action_homeFragment_to_notificationsFragment"
            app:destination="@id/notificationsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
    </fragment>

       <fragment
        android:id="@+id/profileFragment"
        android:name="com.quistock.quistock.presentation.profile.ProfileFragment"
        android:label="@string/profile_title">
        <action
            android:id="@+id/action_profileFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="false" />
        <action
            android:id="@+id/action_profileFragment_to_faqFragment"
            app:destination="@id/faqFragment" />
        <action
            android:id="@+id/action_profileFragment_to_editProfileFragment"
            app:destination="@id/editProfileFragment" />
    </fragment>
    <fragment
        android:id="@+id/faqFragment"
        android:name="com.quistock.quistock.presentation.help.FaqFragment"
        android:label="@string/help_faq_label">
        <action
            android:id="@+id/action_faqFragment_to_profileFragment"
            app:destination="@id/profileFragment"
            app:popUpTo="@id/profileFragment"
            app:popUpToInclusive="false" />
        <action
            android:id="@+id/action_faqFragment_to_contactFragment"
            app:destination="@id/contactFragment" />
    </fragment>

    <fragment
        android:id="@+id/contactFragment"
        android:name="com.quistock.quistock.presentation.help.ContactFragment"
        android:label="@string/help_contact_title">
        <action
            android:id="@+id/action_contactFragment_to_faqFragment"
            app:destination="@id/faqFragment"
            app:popUpTo="@id/faqFragment"
            app:popUpToInclusive="false" />
    </fragment>

    <fragment
        android:id="@+id/editProfileFragment"
        android:name="com.quistock.quistock.presentation.profile.EditProfileFragment"
        android:label="@string/profile_title">
        <action
            android:id="@+id/action_editProfileFragment_to_profileFragment"
            app:destination="@id/profileFragment"
            app:popUpTo="@id/profileFragment"
            app:popUpToInclusive="false" />
    </fragment>

    <fragment
        android:id="@+id/notificationsFragment"
        android:name="com.quistock.quistock.presentation.notifications.NotificationsFragment"
        android:label="@string/notifications_title">
        <action
            android:id="@+id/action_notificationsFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="false" />
    </fragment>

    <fragment
        android:id="@+id/chatbotFragment"
        android:name="com.quistock.quistock.presentation.chatbot.ChatbotFragment"
        android:label="Chatbot" />

    <fragment
        android:id="@+id/orderFragment"
        android:name="com.quistock.quistock.presentation.order.OrderFragment"
        android:label="Criar pedido">
        <action
            android:id="@+id/action_orderFragment_to_orderSentFragment"
            app:destination="@id/orderSentFragment" />
    </fragment>

    <fragment
        android:id="@+id/promotionFragment"
        android:name="com.quistock.quistock.presentation.promotion.PromotionFragment"
        android:label="Criar promoção">
        <action
            android:id="@+id/action_promotionFragment_to_promoSentFragment"
            app:destination="@id/promoSentFragment" />
    </fragment>

    <fragment
        android:id="@+id/orderSentFragment"
        android:name="com.quistock.quistock.presentation.order.OrderSentFragment"
        android:label="Pedido enviado">
        <action
            android:id="@+id/action_orderSentFragment_to_interferencesFragment"
            app:destination="@id/interferencesFragment"
            app:popUpTo="@id/interferencesFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/promoSentFragment"
        android:name="com.quistock.quistock.presentation.promotion.PromoSentFragment"
        android:label="Promoção enviada">
        <action
            android:id="@+id/action_promoSentFragment_to_interferencesFragment"
            app:destination="@id/interferencesFragment"
            app:popUpTo="@id/interferencesFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/interferencesFragment"
        android:name="com.quistock.quistock.presentation.interferences.InterferencesFragment"
        android:label="Interferências" />

    <fragment
        android:id="@+id/managerInterferencesFragment"
        android:name="com.quistock.quistock.presentation.interferences.ManagerInterferencesFragment"
        android:label="Interferências (Gerente)">
        <action
            android:id="@+id/action_managerInterferencesFragment_to_employeeFragment"
            app:destination="@id/employeeFragment" />
        <action
            android:id="@+id/action_managerInterferencesFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
        <action
            android:id="@+id/action_managerInterferencesFragment_to_managerPromotionDetailFragment"
            app:destination="@id/managerPromotionDetailFragment" />
        <action
            android:id="@+id/action_managerInterferencesFragment_to_managerOrderDetailFragment"
            app:destination="@id/managerOrderDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/managerPromotionDetailFragment"
        android:name="com.quistock.quistock.presentation.interferences.ManagerPromotionDetailFragment"
        android:label="Criar promoção">
        <action
            android:id="@+id/action_managerPromotionDetailFragment_to_managerInterferencesFragment"
            app:destination="@id/managerInterferencesFragment"
            app:popUpTo="@id/managerInterferencesFragment"
            app:popUpToInclusive="false" />
    </fragment>

    <fragment
        android:id="@+id/managerOrderDetailFragment"
        android:name="com.quistock.quistock.presentation.interferences.ManagerOrderDetailFragment"
        android:label="Criar pedido">
        <action
            android:id="@+id/action_managerOrderDetailFragment_to_managerInterferencesFragment"
            app:destination="@id/managerInterferencesFragment"
            app:popUpTo="@id/managerInterferencesFragment"
            app:popUpToInclusive="false" />
    </fragment>

    <fragment
        android:id="@+id/productControlFragment"
        android:name="com.quistock.quistock.presentation.control.ProductControlFragment"
        android:label="Controle de produtos">
        <action
            android:id="@+id/action_productControlFragment_to_productDetailFragment"
            app:destination="@id/productDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/productDetailFragment"
        android:name="com.quistock.quistock.presentation.control.ProductDetailFragment"
        android:label="Detalhes do produto" />

    <fragment
        android:id="@+id/employeeFragment"
        android:name="com.quistock.quistock.presentation.employee.EmployeeFragment"
        android:label="Funcionários">
        <action
            android:id="@+id/action_employeeFragment_to_employeeDetailFragment"
            app:destination="@id/employeeDetailFragment" />
        <action
            android:id="@+id/action_employeeFragment_to_employeeProfileFragment"
            app:destination="@id/employeeProfileFragment" />
        <action
            android:id="@+id/action_employeeFragment_to_managerInterferencesFragment"
            app:destination="@id/managerInterferencesFragment" />
    </fragment>

    <fragment
        android:id="@+id/employeeDetailFragment"
        android:name="com.quistock.quistock.presentation.employee.EmployeeDetailFragment"
        android:label="Cadastro de funcionário" />

    <fragment
        android:id="@+id/employeeProfileFragment"
        android:name="com.quistock.quistock.presentation.employee.EmployeeProfileFragment"
        android:label="Perfil do funcionário">
        <action
            android:id="@+id/action_employeeProfileFragment_to_employeeDetailFragment"
            app:destination="@id/employeeDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/cadastroPessoalFragment"
        android:name="com.quistock.quistock.presentation.register.CadastroPessoalFragment"
        android:label="@string/Cadastro">

        <action
            android:id="@+id/action_cadastroPessoalFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:launchSingleTop="true"
            app:popUpTo="@id/loginFragment" />
    </fragment>
</navigation>
