<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.quistock.quistock.presentation.login.LoginFragment"
        android:label="@string/Login">

        <action
            android:id="@+id/action_loginFragment_to_cadastroPessoalFragment"
            app:destination="@id/cadastroPessoalFragment" />
    </fragment>

    <fragment
        android:id="@+id/cadastroPessoalFragment"
        android:name="com.quistock.quistock.presentation.register.CadastroPessoalFragment"
        android:label="@string/Cadastro">

        <action
            android:id="@+id/action_cadastroPessoalFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>
</navigation>