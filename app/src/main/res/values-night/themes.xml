<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark theme mirrors base since QuiStock is natively a dark-themed app. -->
    <style name="Theme.QuiStock" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Paleta da Marca -->
        <item name="colorPrimary">@color/color_violeta</item>
        <item name="colorPrimaryVariant">@color/color_petrolhinho</item>
        <item name="colorOnPrimary">@color/color_branco</item>

        <item name="colorSecondary">@color/color_limao</item>
        <item name="colorSecondaryVariant">@color/color_lavana</item>
        <item name="colorOnSecondary">@color/color_petroleo</item>

        <!-- Superfícies e Janelas em Tema Escuro -->
        <item name="android:windowBackground">@color/color_petroleo</item>
        <item name="android:colorBackground">@color/color_petroleo</item>
        <item name="colorSurface">@color/color_petrolhinho</item>
        <item name="colorOnSurface">@color/color_branco</item>

        <!-- Barra de Status e Navegação -->
        <item name="android:statusBarColor">@color/color_petroleo</item>
        <item name="android:navigationBarColor">@color/color_petroleo</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>

        <!-- Tipografia Padrão Montserrat -->
        <item name="fontFamily">@font/montserrat</item>
        <item name="android:fontFamily">@font/montserrat</item>
    </style>
</resources>