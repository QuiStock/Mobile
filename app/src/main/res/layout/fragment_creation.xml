<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#11061F"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:id="@+id/creationHeader"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Perfil"
                android:tag="current_profile_photo"
                android:src="@drawable/ic_profile" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/creationStore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:tag="current_profile_store"
                    android:textColor="@color/color_branco"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/creationUser"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:tag="current_profile_header_name"
                    android:textColor="#BFAFC5"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/creationBack"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:text="‹  Voltar"
            android:textColor="@color/color_branco"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/creationTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:text="@string/creation_title"
            android:textColor="@color/color_branco"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/creationSelection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/creationAdvisory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_summary"
                android:padding="14dp"
                android:text="@string/creation_advisory"
                android:textColor="#BFAFC5"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/creationProducts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

        </LinearLayout>

        <TextView
            android:id="@+id/creationMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:accessibilityLiveRegion="polite"
            android:textColor="#E8D2F0"
            android:textSize="13sp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/creationProgress"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:contentDescription="@string/creation_loading"
            android:visibility="gone" />

        <TextView
            android:id="@+id/creationProduct"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card_summary"
            android:padding="14dp"
            android:textColor="@color/color_branco"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/creationForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/creationQuantityLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="24dp"
                android:labelFor="@id/creationQuantity"
                android:text="@string/creation_quantity"
                android:textColor="@color/color_branco"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/creationQuantity"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_outline"
                android:hint="@string/creation_quantity_hint"
                android:inputType="number"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:saveEnabled="false"
                android:textColor="@color/color_branco"
                android:textColorHint="#806B88"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/creationOrderDateLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="12dp"
                android:labelFor="@id/creationOrderDate"
                android:text="@string/creation_order_date"
                android:textColor="@color/color_branco"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/creationOrderDate"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_outline"
                android:hint="@string/creation_date_hint"
                android:inputType="date"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:saveEnabled="false"
                android:textColor="@color/color_branco"
                android:textColorHint="#806B88"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/creationDiscountLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="24dp"
                android:labelFor="@id/creationDiscount"
                android:text="@string/creation_discount"
                android:textColor="@color/color_branco"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/creationDiscount"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_outline"
                android:hint="@string/creation_discount_hint"
                android:inputType="numberDecimal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:saveEnabled="false"
                android:textColor="@color/color_branco"
                android:textColorHint="#806B88"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/creationStartLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="12dp"
                android:labelFor="@id/creationStart"
                android:text="@string/creation_start"
                android:textColor="@color/color_branco"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/creationStart"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_outline"
                android:hint="@string/creation_date_hint"
                android:inputType="date"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:saveEnabled="false"
                android:textColor="@color/color_branco"
                android:textColorHint="#806B88"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/creationEndLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="12dp"
                android:labelFor="@id/creationEnd"
                android:text="@string/creation_end"
                android:textColor="@color/color_branco"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/creationEnd"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_outline"
                android:hint="@string/creation_date_hint"
                android:inputType="date"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:saveEnabled="false"
                android:textColor="@color/color_branco"
                android:textColorHint="#806B88"
                android:textSize="12sp" />

            <Button
                android:id="@+id/creationSubmit"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_login_button"
                android:text="@string/creation_review"
                android:textAllCaps="false"
                android:textColor="@color/color_branco"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/creationResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="88dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/creationSuccessIcon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/creation_success_description"
                android:src="@drawable/confirmation"
                android:visibility="gone" />

            <TextView
                android:id="@+id/creationSuccessTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:textColor="@color/color_branco"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/creationSuccessMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:text="@string/creation_sent"
                android:textColor="#D8C9E0"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/creationResultMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:textColor="#D8C9E0"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/creationSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="44dp"
                android:background="@drawable/bg_card_summary"
                android:padding="16dp"
                android:textColor="@color/color_branco"
                android:textSize="12sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/creationForward"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_login_button"
                android:text="@string/creation_forward"
                android:textAllCaps="false"
                android:textColor="@color/color_branco"
                android:visibility="gone" />

            <Button
                android:id="@+id/creationReturn"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_login_button"
                android:text="@string/creation_return"
                android:textAllCaps="false"
                android:textColor="@color/color_branco"
                android:visibility="gone" />
        </LinearLayout>

        <Button
            android:id="@+id/creationRetry"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_login_button"
            android:text="@string/creation_retry"
            android:textAllCaps="false"
            android:textColor="@color/color_branco"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
