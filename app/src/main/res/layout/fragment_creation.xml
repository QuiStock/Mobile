<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_petroleo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="36dp">

        <LinearLayout
            android:id="@+id/creationHeaderContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Perfil"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_profile"
                android:tag="current_profile_photo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/creationStore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:tag="current_profile_store"
                    android:textColor="@color/color_text_title"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Loja Demo 05" />

                <TextView
                    android:id="@+id/creationUser"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:tag="current_profile_header_name"
                    android:textColor="@color/color_text_subtitle"
                    android:textSize="13sp"
                    tools:text="Demo Funcionario 05" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/creationBackContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/creationBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:contentDescription="@string/creation_back"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="36dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="8dp"
                    android:layout_height="14dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:rotation="180"
                    android:src="@drawable/arrow_right"
                    app:tint="@color/color_text_title" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/creation_back"
                    android:textColor="@color/color_text_title"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/creationTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/creation_title"
            android:textColor="@color/color_text_title"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="Pedido de compra" />

        <TextView
            android:id="@+id/creationAdvisory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/creation_advisory"
            android:textColor="@color/color_text_subtitle"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/creationMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:textColor="@color/color_text_title"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Selecione um produto e sua análise atual" />

        <ProgressBar
            android:id="@+id/creationProgress"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="@string/creation_loading"
            android:indeterminateTint="@color/color_violeta" />

        <LinearLayout
            android:id="@+id/creationProducts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/creationProduct"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card_summary"
            android:lineSpacingExtra="4dp"
            android:padding="16dp"
            android:textColor="@color/color_text_title"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="Arroz Branco 5kg\nAlimentos · Estoque: 0\nAnálise: 2026-11-01"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/creationQuantityLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:labelFor="@id/creationQuantity"
            android:text="@string/creation_quantity"
            android:textColor="@color/color_text_title"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/creationQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input_field"
            android:inputType="number"
            android:minHeight="50dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:saveEnabled="false"
            android:textColor="@color/color_text_title"
            android:textColorHint="@color/color_text_caption"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/creationOrderDateLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:labelFor="@id/creationOrderDate"
            android:text="@string/creation_order_date"
            android:textColor="@color/color_text_title"
            android:textSize="13sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/containerOrderDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/creationOrderDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_field"
                android:hint="@string/creation_date_hint"
                android:inputType="date"
                android:minHeight="50dp"
                android:paddingStart="16dp"
                android:paddingEnd="48dp"
                android:saveEnabled="false"
                android:textColor="@color/color_text_title"
                android:textColorHint="@color/color_text_caption"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btnPickOrderDate"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/creation_order_date"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_calendar"
                app:tint="@color/color_violeta" />
        </FrameLayout>

        <TextView
            android:id="@+id/creationDiscountLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:labelFor="@id/creationDiscount"
            android:text="@string/creation_discount"
            android:textColor="@color/color_text_title"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/creationDiscount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input_field"
            android:inputType="numberDecimal"
            android:minHeight="50dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:saveEnabled="false"
            android:textColor="@color/color_text_title"
            android:textColorHint="@color/color_text_caption"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/creationStartLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:labelFor="@id/creationStart"
            android:text="@string/creation_start"
            android:textColor="@color/color_text_title"
            android:textSize="13sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/containerStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/creationStart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_field"
                android:hint="@string/creation_date_hint"
                android:inputType="date"
                android:minHeight="50dp"
                android:paddingStart="16dp"
                android:paddingEnd="48dp"
                android:saveEnabled="false"
                android:textColor="@color/color_text_title"
                android:textColorHint="@color/color_text_caption"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btnPickStart"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/creation_start"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_calendar"
                app:tint="@color/color_violeta" />
        </FrameLayout>

        <TextView
            android:id="@+id/creationEndLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:labelFor="@id/creationEnd"
            android:text="@string/creation_end"
            android:textColor="@color/color_text_title"
            android:textSize="13sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/containerEnd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/creationEnd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_field"
                android:hint="@string/creation_date_hint"
                android:inputType="date"
                android:minHeight="50dp"
                android:paddingStart="16dp"
                android:paddingEnd="48dp"
                android:saveEnabled="false"
                android:textColor="@color/color_text_title"
                android:textColorHint="@color/color_text_caption"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btnPickEnd"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/creation_end"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_calendar"
                app:tint="@color/color_violeta" />
        </FrameLayout>

        <TextView
            android:id="@+id/creationSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card_summary"
            android:lineSpacingExtra="4dp"
            android:padding="16dp"
            android:textColor="@color/color_text_title"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="Resumo da ação..."
            tools:visibility="visible" />

        <Space
            android:id="@+id/creationSentTopSpace"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/creationSentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginTop="20dp"
                android:contentDescription="Confirmação"
                android:src="@drawable/confirmation" />

            <TextView
                android:id="@+id/creationSentTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:textColor="@color/color_text_title"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Pedido enviado" />

            <TextView
                android:id="@+id/creationSentSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="@color/color_text_subtitle"
                android:textSize="13sp"
                tools:text="Aguarde a aprovação do pedido!" />

            <LinearLayout
                android:id="@+id/creationSentDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_card_summary"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/creationSentDetailsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="6dp"
                    android:textColor="@color/color_text_title"
                    android:textSize="13sp"
                    tools:text="Produto: Arroz Branco 5kg\nQuantidade: 20 un\nData: 2026-11-10\nStatus: Pendente" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/creationSubmit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_login_button"
            android:minHeight="52dp"
            android:text="@string/creation_review"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/creationForward"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_login_button"
            android:minHeight="52dp"
            android:text="@string/creation_forward"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/creationRetry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_btn_secondary"
            android:minHeight="50dp"
            android:text="@string/creation_retry"
            android:textAllCaps="false"
            android:textColor="@color/color_violeta"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/creationReturn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_login_button"
            android:minHeight="52dp"
            android:text="@string/creation_return"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <Space
            android:id="@+id/creationSentBottomSpace"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
