<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_petroleo"
    tools:context=".presentation.interferences.InterferencesFragment">

    <ScrollView
        android:id="@+id/scrollInterferencias"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="30dp"
            android:paddingTop="28dp"
            android:paddingEnd="30dp">

            <!-- HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView android:tag="current_profile_photo"
                android:layout_width="39dp"
                android:layout_height="39dp"
                    android:contentDescription="Perfil"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_profile" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView android:tag="current_profile_store"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Loja Av. Paulista"
                        android:textColor="@color/color_branco"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView android:tag="current_profile_header_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Milena Souza"
                        android:textColor="#BFAFC5"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                android:layout_width="19dp"
                android:layout_height="23dp"
                    android:contentDescription="Notificações"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_notification" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginTop="54dp"
                android:text="Interferências"
                android:textColor="@color/color_branco"
                android:textSize="26sp"
                android:textStyle="bold" />

            <!-- CARDS DE AÇÃO: PROMOÇÃO / PEDIDO DE ESTOQUE -->
            <LinearLayout
                android:id="@+id/containerBotoesAcao"
                android:layout_width="match_parent"
                android:layout_height="163dp"
                android:layout_marginStart="9dp"
                android:layout_marginTop="22dp"
                android:layout_marginEnd="9dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/cardPromocao"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="18dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_interference_category"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="65dp"
                        android:layout_height="73dp"
                        android:contentDescription="Promoção"
                        android:scaleType="fitCenter"
                        android:src="@drawable/promo" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Promoção"
                        android:textColor="#D8C9E0"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardPedidoEstoque"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="18dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_interference_category"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="67dp"
                        android:layout_height="75dp"
                        android:contentDescription="Pedido de estoque"
                        android:scaleType="fitCenter"
                        android:src="@drawable/box" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Pedido de estoque"
                        android:textColor="#D8C9E0"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/interferenceActiveTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_marginTop="22dp"
                android:text="@string/interference_active"
                android:textColor="@color/color_branco"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/interferenceListProgress"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="16dp"
                android:accessibilityLiveRegion="polite"
                android:contentDescription="@string/creation_loading"
                android:visibility="gone" />

            <TextView
                android:id="@+id/interferenceListMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:accessibilityLiveRegion="polite"
                android:textColor="#BFAFC5"
                android:visibility="gone" />

            <Button
                android:id="@+id/interferenceListRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/creation_retry"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/listaInterferenciasAtivas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginTop="16dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/interferenceRecentTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_marginTop="20dp"
                android:text="@string/interference_recent"
                android:textColor="@color/color_branco"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/listaInterferenciasRecentes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp"
                android:layout_marginTop="16dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <!-- BOTTOM NAVIGATION -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="@dimen/nav_bar_height"
        android:background="@color/color_petroleo"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageButton
            android:id="@+id/btnHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Início"
            android:paddingTop="17dp"
            android:paddingBottom="17dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_home" />

        <ImageButton
            android:id="@+id/btnMovimentacoes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Interferências"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_interferences_active" />

        <ImageButton
            android:id="@+id/btnProdutos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Produtos"
            android:paddingTop="17dp"
            android:paddingBottom="17dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_product_control" />

        <ImageButton
            android:id="@+id/btnFolha"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Chat"
            android:paddingTop="17dp"
            android:paddingBottom="17dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chatbot" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
