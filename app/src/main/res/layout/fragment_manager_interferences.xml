<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#11061F"
    tools:context=".presentation.interferences.ManagerInterferencesFragment">

    <ScrollView
        android:id="@+id/scrollInterferencias"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationInterferencias"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="27dp"
            android:paddingTop="52dp"
            android:paddingEnd="27dp">

            <!-- Header da Loja -->
            <LinearLayout
                android:id="@+id/headerInterferencias"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView android:tag="current_profile_photo"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="Perfil"
                    android:src="@drawable/ic_profile" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView android:tag="current_profile_store"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Loja Av. Paulista"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView android:tag="current_profile_header_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Milena Souza"
                        android:textColor="#BFAFC5"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnNotificacoesInterferencias"
                    android:layout_width="19dp"
                    android:layout_height="23dp"
                    android:contentDescription="Notificações"
                    android:src="@drawable/ic_notification" />
            </LinearLayout>

            <!-- Título -->
            <TextView
                android:id="@+id/tvTituloInterferencias"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="38dp"
                android:text="Interferências"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Cards Topo: Promoção e Pedido de estoque -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="122dp"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/cardPromocao"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="13dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_interference_category"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:contentDescription="Promoção"
                        android:src="@drawable/promo" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Promoção"
                        android:textColor="#D8C9E0"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardPedidoEstoque"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="13dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_interference_category"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:contentDescription="Pedido de estoque"
                        android:src="@drawable/box" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Pedido de estoque"
                        android:textColor="#D8C9E0"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Seção de Pedidos para Analisar (Scroll 1) -->
            <ScrollView
                android:id="@+id/scrollPedidosAnalisar"
                android:layout_width="match_parent"
                android:layout_height="108dp"
                android:layout_marginTop="20dp"
                android:fillViewport="false"
                android:nestedScrollingEnabled="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/cardAcaoPedidoPromocao"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/bg_card_summary"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="13dp"
                        android:paddingEnd="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Pedido de promoção"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnAnalisarPromocao"
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:background="@drawable/bg_card_summary"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="Analisar"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/cardAcaoPedidoEstoque"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/bg_card_summary"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="13dp"
                        android:paddingEnd="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Pedido de estoque"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnAnalisarEstoque"
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:background="@drawable/bg_card_summary"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="Analisar"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <!-- Seção: Interferências ativas (Scroll 2) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_marginTop="16dp"
                android:text="Interferências ativas"
                android:textColor="#E8D2F0"
                android:textSize="13sp" />

            <ScrollView
                android:id="@+id/scrollInterferenciasAtivas"
                android:layout_width="match_parent"
                android:layout_height="108dp"
                android:layout_marginTop="12dp"
                android:fillViewport="false"
                android:nestedScrollingEnabled="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Card Ativo 1: Promoção -->
                    <LinearLayout
                        android:id="@+id/cardAtivoPromocao"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/bg_card_summary"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="13dp"
                        android:paddingEnd="12dp">

                        <TextView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:gravity="center"
                            android:text="%"
                            android:textColor="#FFFFFF"
                            android:textSize="25sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Promoção Verão 25%"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Em vigor: 15:35 AM · Expira em 3 dias"
                                android:textColor="#BFAFC5"
                                android:textSize="9sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Card Ativo 2: Pedido -->
                    <LinearLayout
                        android:id="@+id/cardAtivoPedido"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/bg_card_summary"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="13dp"
                        android:paddingEnd="12dp">

                        <ImageView
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:contentDescription="Pedido de estoque"
                            android:src="@drawable/ic_product_control" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pedido #1014 - Refrigerantes"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Recebimento pendente · Solicitado: 02:32 AM"
                                android:textColor="#BFAFC5"
                                android:textSize="9sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Gerente (5 abas, Interferências ativo) -->
    <LinearLayout
        android:id="@+id/bottomNavigationInterferencias"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:background="#11061F"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageButton
            android:id="@+id/btnHomeNav"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Início"
            android:padding="0dp"
            android:src="@drawable/ic_home" />

        <ImageButton
            android:id="@+id/btnInterferenciasNav"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Interferências"
            android:padding="0dp"
            android:src="@drawable/ic_interferences_active" />

        <ImageButton
            android:id="@+id/btnFuncionariosNav"
            android:layout_width="0dp"
            android:layout_height="25dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Funcionários"
            android:padding="0dp"
            android:src="@drawable/ic_employee" />

        <ImageButton
            android:id="@+id/btnNotificacoesNav"
            android:layout_width="0dp"
            android:layout_height="25dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Notificações"
            android:padding="0dp"
            android:src="@drawable/ic_notification" />

        <ImageButton
            android:id="@+id/btnChatbotNav"
            android:layout_width="0dp"
            android:layout_height="25dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Chatbot"
            android:padding="0dp"
            android:src="@drawable/ic_chatbot" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
