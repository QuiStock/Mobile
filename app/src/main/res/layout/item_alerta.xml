<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="112dp"
    android:layout_marginBottom="18dp"
    android:background="@drawable/bg_alert"
    android:padding="0dp">


    <!-- PRODUTO -->

    <TextView
        android:id="@+id/tvProduto"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="10dp"
        android:text="Nome do produto"
        android:textColor="#E8D2F0"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/tvData"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <!-- CATEGORIA -->

    <TextView
        android:id="@+id/tvCategoria"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Categoria • quantidade"
        android:textColor="#AFA0B5"
        android:textSize="10sp"
        app:layout_constraintEnd_toEndOf="@id/tvProduto"
        app:layout_constraintStart_toStartOf="@id/tvProduto"
        app:layout_constraintTop_toBottomOf="@id/tvProduto" />


    <!-- DATA -->

    <TextView
        android:id="@+id/tvData"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:text="06/08/2026"
        android:textColor="#E8D2F0"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <!-- LABEL DATA -->

    <TextView
        android:id="@+id/tvLabelData"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Validade"
        android:textColor="#AFA0B5"
        android:textSize="9sp"
        app:layout_constraintStart_toStartOf="@id/tvData"
        app:layout_constraintTop_toBottomOf="@id/tvData" />


    <!-- BOTÃO DE AÇÃO -->

    <LinearLayout
        android:id="@+id/layoutBotoes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal"
        android:weightSum="2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnPromocao"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_btn_alert"
            android:text="Criar promoção de 15%"
            android:textAllCaps="false"
            android:textColor="#E8D2F0"
            android:textSize="9sp"/>

        <Button
            android:id="@+id/btnFefo"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_btn_alert"
            android:text="Ajuda do FEFO"
            android:textAllCaps="false"
            android:textColor="#E8D2F0"
            android:textSize="9sp"/>

    </LinearLayout>

    <ImageView
        android:id="@+id/imgPassarinho"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:src="@drawable/img_fefo_btn"
        app:layout_constraintBottom_toBottomOf="@id/layoutBotoes"
        app:layout_constraintEnd_toEndOf="@id/layoutBotoes"
        android:translationX="10dp"
        android:translationY="-4dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>