            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="28dp"
            android:paddingEnd="24dp"
            android:paddingBottom="8dp">

            <!-- HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView android:tag="current_profile_photo"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="Perfil"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_profile" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView android:tag="current_profile_store"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Loja Av. Paulista"
                        android:textColor="@color/color_branco"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView android:tag="current_profile_header_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Milena Souza"
                        android:textColor="#BFAFC5"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Notificações"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_notification" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Controle"
                android:textColor="@color/color_branco"
                android:textSize="24sp"
                android:textStyle="bold" />

