<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/login_background"
    tools:context=".presentation.help.ContactFragment">

    <LinearLayout
        android:id="@+id/contact_store_header"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView android:tag="current_profile_photo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/profile_store_name"
            android:src="@drawable/ic_profile" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView android:tag="current_profile_store"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_store_name"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView android:tag="current_profile_header_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_user_name"
                android:textColor="#BFAFC5"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/contact_back_control"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:clickable="true"
        android:contentDescription="@string/profile_back"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/contact_store_header">

        <ImageView
            android:layout_width="8dp"
            android:layout_height="14dp"
            android:importantForAccessibility="no"
            android:rotation="180"
            android:src="@drawable/arrow_right" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:gravity="center_vertical"
            android:text="@string/profile_back"
            android:textColor="@color/white"
            android:textSize="13sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/contact_scroll_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/contact_back_control">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="4dp"
            android:paddingEnd="24dp">

            <TextView
                android:id="@+id/contact_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/help_contact_title"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:labelFor="@id/contact_name_input"
                android:text="@string/help_name_label"
                android:textColor="@color/white"
                android:textSize="11sp" />

            <EditText android:tag="current_profile_name_input"
                android:id="@+id/contact_name_input"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_outline"
                android:inputType="textPersonName|textCapWords"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:text="@string/profile_user_name"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="14dp"
                android:labelFor="@id/contact_email_input"
                android:text="@string/help_email_label"
                android:textColor="@color/white"
                android:textSize="11sp" />

            <EditText android:tag="current_profile_email_input"
                android:id="@+id/contact_email_input"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_outline"
                android:inputType="textEmailAddress"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:text="@string/help_email_value"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="14dp"
                android:labelFor="@id/contact_problem_input"
                android:text="@string/help_problem_label"
                android:textColor="@color/white"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/contact_problem_input"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_outline"
                android:hint="@string/help_problem_hint"
                android:inputType="textCapSentences"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="@color/white"
                android:textColorHint="#805A8A"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="14dp"
                android:labelFor="@id/contact_message_input"
                android:text="@string/help_message_label"
                android:textColor="@color/white"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/contact_message_input"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_outline"
                android:gravity="top|start"
                android:hint="@string/help_message_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:padding="12dp"
                android:textColor="@color/white"
                android:textColorHint="#805A8A"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/contact_send_button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_login_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/help_send"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
