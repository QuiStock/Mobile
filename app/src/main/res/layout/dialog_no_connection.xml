<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_popup_dialog"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="20dp">
    <TextView
        android:id="@+id/closeNoConnection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="Fechar"
        android:gravity="end"
        android:text="×"
        android:textColor="#FFFFFF"
        android:textSize="20sp" />
    <ImageView
        android:layout_width="160dp"
        android:layout_height="130dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_no_connection" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Sem conexão com a Internet!"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="18dp"
        android:text="Verifique sua rede Wi-Fi ou dados móveis e tente novamente."
        android:textColor="#FFFFFF"
        android:textSize="12sp" />
    <Button
        android:id="@+id/retryNoConnection"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/bg_login_button"
        android:text="Tentar novamente"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
