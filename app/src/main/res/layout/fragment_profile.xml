<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_petroleo"
    tools:context=".presentation.profile.ProfileFragment">

    <!-- HEADER LOJA -->
    <LinearLayout
        android:id="@+id/profile_store_header"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView android:tag="current_profile_photo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/profile_store_name"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_profile" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView android:tag="current_profile_store"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_store_name"
                android:textColor="@color/color_branco"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView android:tag="current_profile_header_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_user_name"
                android:textColor="#BFAFC5"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- VOLTAR -->
    <LinearLayout
        android:id="@+id/profile_back_control"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:clickable="true"
        android:contentDescription="@string/profile_back"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/profile_store_header">

        <ImageView
            android:layout_width="10dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:rotation="180"
            android:src="@drawable/arrow_right" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:gravity="center_vertical"
            android:text="@string/profile_back"
            android:textColor="@color/color_branco"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/profile_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:text="@string/profile_title"
        android:textColor="@color/color_branco"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/profile_back_control" />

    <ScrollView
        android:id="@+id/profile_scroll_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/profile_title">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginTop="12dp"
            <ImageView android:tag="current_profile_photo"
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:layout_marginTop="8dp"
                android:contentDescription="@string/profile_user_name"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_profile" />

            <TextView android:tag="current_profile_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/profile_user_name"
                android:textColor="@color/color_branco"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView android:tag="current_profile_role"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/profile_role"
                android:textColor="#BFAFC5"
                android:textSize="13sp" />

            <!-- ROW: MINHA CONTA -->
            <LinearLayout
                android:id="@+id/profile_account_row"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_account"
                        android:textColor="@color/color_branco"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/profile_account_description"
                        android:textColor="#BFAFC5"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/arrow_right" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#337F3AEF" />

            <!-- ROW: MINHA LOJA -->
            <LinearLayout
                android:id="@+id/profile_store_row"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_store"
                        android:textColor="@color/color_branco"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView android:tag="current_profile_store"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/profile_store_name"
                        android:textColor="#BFAFC5"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/arrow_right" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#337F3AEF" />

            <!-- ROW: AJUDA -->
            <LinearLayout
                android:id="@+id/profile_help_row"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_help"
                        android:textColor="@color/color_branco"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/profile_help_description"
                        android:textColor="#BFAFC5"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/arrow_right" />
            </LinearLayout>

            <!-- EDITAR PERFIL BUTTON -->
            <TextView
                android:id="@+id/profile_edit_button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_login_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/profile_edit"
                android:textColor="@color/color_branco"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- SAIR DA CONTA -->
            <TextView
                android:id="@+id/profile_sign_out_button"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/profile_sign_out"
                android:textColor="#E8A8F4"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
