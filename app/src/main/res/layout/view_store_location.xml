<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/location_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/location_title"
            android:textColor="@color/color_branco"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/location_description"
            android:textColor="#BFAFC5"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/location_card"
        android:stateListAnimator="@animator/press_scale"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_location_card"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="12dp">

        <FrameLayout
            android:id="@+id/location_preview"
            android:layout_width="match_parent"
            android:layout_height="132dp"
            android:background="@drawable/bg_location_preview"
            android:clipToOutline="true"
            android:contentDescription="@string/location_preview_description">

            <ImageView
                android:id="@+id/location_pin_placeholder"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_location_pin" />

            <com.google.android.gms.maps.MapView
                android:id="@+id/location_map"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:visibility="gone"
                app:liteMode="true" />

            <View
                android:id="@+id/location_skeleton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_location_skeleton"
                android:contentDescription="@string/location_loading_description"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/location_street"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/color_branco"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/location_city"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#BFAFC5"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/location_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#BFAFC5"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/location_open_button"
            android:stateListAnimator="@animator/press_scale"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_location_button"
            android:clickable="true"
            android:drawableStart="@drawable/ic_directions"
            android:drawablePadding="8dp"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/location_open"
            android:textColor="@color/color_branco"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/location_retry_button"
            android:stateListAnimator="@animator/press_scale"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_location_button_outline"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/location_retry"
            android:textColor="@color/color_branco"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
