<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#11061F"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="24dp"
    tools:context=".presentation.employee.EditEmployeeFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Header da Loja / Usuário -->
        <LinearLayout
            android:id="@+id/headerEditarFuncionario"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="44dp"
            android:layout_marginEnd="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView android:tag="current_profile_photo"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="Perfil"
                android:src="@drawable/ic_profile" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView android:tag="current_profile_store"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Loja Av. Paulista"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView android:tag="current_profile_header_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Milena Souza"
                    android:textColor="#BFAFC5"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Botão Voltar -->
        <LinearLayout
            android:id="@+id/btnVoltarEditarFuncionario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="31dp"
            android:layout_marginTop="28dp"
            android:clickable="true"
            android:contentDescription="Voltar"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerEditarFuncionario">

            <ImageView
                android:layout_width="8dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:rotation="180"
                android:src="@drawable/arrow_right" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Voltar"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Título Editar funcionário -->
        <TextView
            android:id="@+id/tvTituloEditarFuncionario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="31dp"
            android:layout_marginTop="16dp"
            android:text="Editar funcionário"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnVoltarEditarFuncionario" />

        <!-- Avatar Central do Funcionário -->
        <ImageView
            android:id="@+id/ivFotoEditarFuncionario"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="24dp"
            android:contentDescription="Foto do funcionário"
            android:src="@drawable/ic_profile"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTituloEditarFuncionario" />

        <!-- Formulário de Edição -->
        <LinearLayout
            android:id="@+id/areaFormularioEdicao"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="31dp"
            android:layout_marginTop="28dp"
            android:layout_marginEnd="31dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivFotoEditarFuncionario">

            <!-- Campo Nome Completo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Nome Completo"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/etNomeCompleto"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_card_summary"
                android:hint="Ex: Milena Souza"
                android:imeOptions="actionNext"
                android:inputType="textPersonName|textCapWords"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:text="Breno Almeida Alves"
                android:textColor="#FFFFFF"
                android:textColorHint="#C7B7CC"
                android:textSize="12sp" />

            <!-- Campo E-mail -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="16dp"
                android:text="E-mail"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_card_summary"
                android:hint="Ex: milena.souza@quistock.com"
                android:imeOptions="actionNext"
                android:inputType="textEmailAddress"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:text="bruno.alves@quistock.com."
                android:textColor="#FFFFFF"
                android:textColorHint="#C7B7CC"
                android:textSize="12sp" />

            <!-- Campo Cargo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="16dp"
                android:text="Cargo"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/etCargo"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_card_summary"
                android:hint="Ex: Estoquista"
                android:imeOptions="actionDone"
                android:inputType="textCapWords"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:text="Estoquista"
                android:textColor="#FFFFFF"
                android:textColorHint="#C7B7CC"
                android:textSize="12sp" />

            <!-- Botão Salvar alterações -->
            <Button
                android:id="@+id/btnSalvarAlteracoes"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_login_button"
                android:text="Salvar alterações"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <!-- Ação Cancelar -->
            <TextView
                android:id="@+id/btnCancelarEdicao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"
                android:text="Cancelar"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
