<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_petroleo"
    tools:context=".presentation.chatbot.ChatbotFragment">

    <!-- TOP BAR -->
    <ImageButton
        android:id="@+id/btnMenuChatbot"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="28dp"
        android:background="@android:color/transparent"
        android:contentDescription="Menu"
        android:padding="0dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_menu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTituloChatbot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:text="Boas-vindas"
        android:textColor="@color/color_branco"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btnMenuChatbot"
        app:layout_constraintStart_toEndOf="@id/btnMenuChatbot"
        app:layout_constraintTop_toTopOf="@id/btnMenuChatbot" />

    <ImageButton
        android:id="@+id/btnNotificacoesChatbot"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="24dp"
        android:background="@android:color/transparent"
        android:contentDescription="Notificações"
        android:padding="0dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_notification"
        app:layout_constraintBottom_toBottomOf="@id/btnMenuChatbot"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnMenuChatbot" />

    <!-- ÁREA DE MENSAGENS -->
    <ScrollView
        android:id="@+id/scrollMensagens"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="24dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/areaEntrada"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnMenuChatbot">

        <LinearLayout
            android:id="@+id/containerMensagens"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="vertical" />
    </ScrollView>

    <!-- ÁREA DE ENTRADA -->
    <LinearLayout
        android:id="@+id/areaEntrada"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationChatbot"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <EditText
            android:id="@+id/etPerguntaChatbot"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_input_outline"
            android:hint="Digite sua pergunta"
            android:imeOptions="actionSend"
            android:inputType="textCapSentences|textMultiLine"
            android:gravity="center_vertical|start"
            android:minHeight="46dp"
            android:maxHeight="120dp"
            android:scrollbars="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/color_branco"
            android:textColorHint="#8F7898"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnEnviarPergunta"
            android:layout_width="44dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:background="@android:color/transparent"
            android:contentDescription="Enviar pergunta"
            android:gravity="center"
            android:text="➤"
            android:textColor="@color/color_branco"
            android:textSize="24sp" />
    </LinearLayout>

    <!-- BOTTOM NAVIGATION -->
    <LinearLayout
        android:id="@+id/bottomNavigationChatbot"
        android:layout_width="0dp"
        android:layout_height="@dimen/nav_bar_height"
        android:background="@color/color_petroleo"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageButton
            android:id="@+id/btnHomeChatbot"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Início"
            android:paddingTop="17dp"
            android:paddingBottom="17dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_home" />

        <ImageButton
            android:id="@+id/btnInterferenciasChatbot"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Interferências"
            android:paddingTop="17dp"
            android:paddingBottom="17dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_interferences" />

        <ImageButton
            android:id="@+id/btnProdutosChatbot"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Controle de produtos"
            android:paddingTop="17dp"
            android:paddingBottom="17dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_product_control" />

        <ImageButton
            android:id="@+id/btnChatbotAtivo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Chatbot"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chatbot_active" />
    </LinearLayout>

    <!-- OVERLAY MENU LATERAL -->
    <FrameLayout
        android:id="@+id/chatMenuOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:focusable="true"
        android:elevation="12dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/chatMenuPanel"
            android:layout_width="280dp"
            android:layout_height="match_parent"
            android:background="@color/color_petrolhinho"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingStart="26dp"
            android:paddingTop="38dp"
            android:paddingEnd="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QuiStock"
                android:textColor="@color/color_branco"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView android:tag="current_profile_photo"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:contentDescription="Perfil"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_profile" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">
                    <TextView android:tag="current_profile_store"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Loja Av. Paulista"
                        android:textColor="@color/color_branco"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    <TextView android:tag="current_profile_header_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Milena Souza"
                        android:textColor="#D2C7D8"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnNewChat"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="34dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_new_chat" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Novo chat"
                    android:textColor="@color/color_branco"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Recentes"
                android:textColor="@color/color_branco"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:gravity="center_vertical"
                android:text="Novo chat"
                android:textColor="#D2C7D8"
                android:textSize="13sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:gravity="center_vertical"
                android:text="O que é o QuiStock?"
                android:textColor="#D2C7D8"
                android:textSize="13sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="42dp"
                android:text="Sugestão de promoção de inverno"
                android:textColor="#D2C7D8"
                android:textSize="13sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_chat_selected"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:text="Boas-vindas"
                android:textColor="@color/color_branco"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
