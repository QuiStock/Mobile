<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_petroleo"
    tools:context=".presentation.chatbot.ChatbotFragment">

    <!-- TOP BAR -->
    <ImageButton
        android:id="@+id/btnMenuChatbot"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_circle_button"
        android:contentDescription="Menu"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_menu"
        app:tint="@color/color_text_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTituloChatbot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Boas-vindas"
        android:textColor="@color/color_text_title"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btnMenuChatbot"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnMenuChatbot" />

    <ImageButton
        android:id="@+id/btnNotificacoesChatbot"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_circle_button"
        android:contentDescription="Notificações"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_notification"
        app:tint="@color/color_text_title"
        app:layout_constraintBottom_toBottomOf="@id/btnMenuChatbot"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnMenuChatbot" />

    <!-- WELCOME STATE (FEFO) -->
    <LinearLayout
        android:id="@+id/layoutWelcomeChatbot"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/areaEntrada"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnMenuChatbot">

        <ImageView
            android:id="@+id/ivFefoMascot"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:contentDescription="Fefo"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_fefo" />

        <TextView
            android:id="@+id/tvWelcomeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Boas-vindas"
            android:textColor="@color/color_text_title"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWelcomeSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:maxWidth="280dp"
            android:text="Pergunte sobre estoque, validade ou promoções da sua loja."
            android:textColor="@color/color_text_subtitle"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- ÁREA DE MENSAGENS -->
    <ScrollView
        android:id="@+id/scrollMensagens"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/areaEntrada"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnMenuChatbot">

        <LinearLayout
            android:id="@+id/containerMensagens"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="vertical" />
    </ScrollView>

    <!-- ÁREA DE ENTRADA -->
    <LinearLayout
        android:id="@+id/areaEntrada"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_chat_input_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="6dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationChatbot"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <EditText
            android:id="@+id/etPerguntaChatbot"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="Digite sua pergunta"
            android:imeOptions="actionSend"
            android:inputType="textCapSentences|textMultiLine"
            android:gravity="center_vertical|start"
            android:maxLines="3"
            android:paddingStart="0dp"
            android:paddingEnd="8dp"
            android:textColor="@color/color_text_title"
            android:textColorHint="@color/color_text_subtitle"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btnEnviarPergunta"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_circle_send"
            android:contentDescription="Enviar pergunta"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_arrow_up" />
    </LinearLayout>

    <!-- BOTTOM NAVIGATION -->
    <LinearLayout
        android:id="@+id/bottomNavigationChatbot"
        android:layout_width="0dp"
        android:layout_height="@dimen/nav_bar_height"
        android:background="@color/color_petroleo"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageButton
            android:id="@+id/btnHomeChatbot"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Início"
            android:paddingTop="17dp"
            android:paddingBottom="17dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_home" />

        <ImageButton
            android:id="@+id/btnInterferenciasChatbot"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Interferências"
            android:paddingTop="17dp"
            android:paddingBottom="17dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_interferences" />

        <ImageButton
            android:id="@+id/btnProdutosChatbot"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Controle de produtos"
            android:paddingTop="17dp"
            android:paddingBottom="17dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_product_control" />

        <ImageButton
            android:id="@+id/btnChatbotAtivo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Chatbot"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chatbot_active" />
    </LinearLayout>

    <!-- OVERLAY MENU LATERAL -->
    <FrameLayout
        android:id="@+id/chatMenuOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:focusable="true"
        android:elevation="12dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/chatMenuPanel"
            android:layout_width="280dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_card_summary"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="36dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <ImageView
                android:layout_width="140dp"
                android:layout_height="34dp"
                android:contentDescription="@string/app_name"
                android:scaleType="fitStart"
                android:src="@drawable/logotipo" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_card_interference_category"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">
                <ImageView android:tag="current_profile_photo"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:contentDescription="Perfil"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_profile" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:tag="current_profile_store"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Loja Av. Paulista"
                        android:textColor="@color/color_text_title"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    <TextView android:tag="current_profile_header_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Milena Souza"
                        android:textColor="@color/color_text_subtitle"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnNewChat"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card_active"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_new_chat"
                    app:tint="@color/color_branco" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Novo chat"
                    android:textColor="@color/color_branco"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Recentes"
                android:textColor="@color/color_text_title"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="10dp"
                android:fillViewport="true">
                <LinearLayout
                    android:id="@+id/recentConversations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
