<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#11061F"
    tools:context=".presentation.employee.EmployeeFragment">

    <LinearLayout
        android:id="@+id/headerFuncionarios"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="44dp"
        android:layout_marginEnd="32dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView android:tag="current_profile_photo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="Perfil"
            android:src="@drawable/ic_profile" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView android:tag="current_profile_store"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loja Av. Paulista"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView android:tag="current_profile_header_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Milena Souza"
                android:textColor="#BFAFC5"
                android:textSize="10sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnNotificacoesFuncionarios"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@android:color/transparent"
            android:contentDescription="Notificações"
            android:padding="0dp"
            android:src="@drawable/ic_notification" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvTituloControleFuncionarios"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="31dp"
        android:layout_marginTop="27dp"
        android:text="Controle"
        android:textColor="#FFFFFF"
        android:textSize="21sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerFuncionarios" />

    <LinearLayout
        android:id="@+id/areaFiltrosFuncionarios"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginStart="31dp"
        android:layout_marginTop="17dp"
        android:layout_marginEnd="31dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTituloControleFuncionarios">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1.2"
            android:background="@drawable/bg_card_summary"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <EditText
                android:id="@+id/etBuscaFuncionario"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Pesquisar pelo nome"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:padding="0dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#C7B7CC"
                android:textSize="9sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Buscar funcionário"
                android:text="⌕"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dropdownFiltroDataFuncionario"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_summary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Filtrar por data"
                android:textColor="#FFFFFF"
                android:textSize="9sp" />

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:contentDescription="Abrir filtro de data"
                android:src="@drawable/arrow_down" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btnCadastrarFuncionario"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginStart="31dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="31dp"
        android:background="@drawable/bg_login_button"
        android:text="Cadastrar funcionário"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/areaFiltrosFuncionarios" />

    <ScrollView
        android:id="@+id/scrollFuncionarios"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="31dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="31dp"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationFuncionarios"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnCadastrarFuncionario">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="0dp"
            android:paddingEnd="0dp">

            <include
                android:id="@+id/cardBrunaAlves"
                layout="@layout/item_employee_card" />

            <View
                android:layout_width="match_parent"
                android:layout_height="20dp" />

            <include
                android:id="@+id/cardRicardoMacedo"
                layout="@layout/item_employee_card" />

            <View
                android:layout_width="match_parent"
                android:layout_height="20dp" />

            <include
                android:id="@+id/cardBrenoAlmeida"
                layout="@layout/item_employee_card" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomNavigationFuncionarios"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="#11061F"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageButton
            android:id="@+id/btnHomeFuncionarios"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Início"
            android:padding="0dp"
            android:src="@drawable/ic_home" />

        <ImageButton
            android:id="@+id/btnMovimentacoesFuncionarios"
            android:layout_width="0dp"
            android:layout_height="25dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Movimentações"
            android:padding="0dp"
            android:src="@drawable/ic_interferences" />

        <ImageButton
            android:id="@+id/btnControleFuncionariosAtivo"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Funcionários"
            android:padding="0dp"
            android:src="@drawable/ic_employee_active" />

        <ImageButton
            android:id="@+id/btnNotificacoesBottomFuncionarios"
            android:layout_width="0dp"
            android:layout_height="25dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Notificações"
            android:padding="0dp"
            android:src="@drawable/ic_notification" />

        <ImageButton
            android:id="@+id/btnChatbotFuncionarios"
            android:layout_width="0dp"
            android:layout_height="25dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Chatbot"
            android:padding="0dp"
            android:src="@drawable/ic_chatbot" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
