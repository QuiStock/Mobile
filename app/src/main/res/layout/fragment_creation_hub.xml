<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_petroleo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="36dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Perfil"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_profile"
                android:tag="current_profile_photo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/creationStore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:tag="current_profile_store"
                    android:textColor="@color/color_text_title"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/creationUser"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:tag="current_profile_header_name"
                    android:textColor="@color/color_text_subtitle"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/creationTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/creation_title"
            android:textColor="@color/color_text_title"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/creationOrder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_login_button"
            android:minHeight="52dp"
            android:text="@string/creation_order"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/creationPromotion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_btn_secondary"
            android:minHeight="50dp"
            android:text="@string/creation_promotion"
            android:textAllCaps="false"
            android:textColor="@color/color_violeta"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/creationResume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_btn_secondary"
            android:minHeight="50dp"
            android:text="@string/creation_resume"
            android:textAllCaps="false"
            android:textColor="@color/color_violeta"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/creationRetry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_btn_secondary"
            android:minHeight="50dp"
            android:text="@string/creation_retry"
            android:textAllCaps="false"
            android:textColor="@color/color_violeta"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/creationMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:textColor="@color/color_text_subtitle"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/creationHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="@string/creation_history"
            android:textColor="@color/color_text_title"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/creationActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
