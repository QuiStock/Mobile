<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_petroleo"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="32dp"
    tools:context=".presentation.interferences.ManagerPromotionDetailFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Header da Loja -->
        <LinearLayout
            android:id="@+id/headerDetalhePromocao"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="27dp"
            android:layout_marginTop="52dp"
            android:layout_marginEnd="27dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView android:tag="current_profile_photo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Perfil"
                android:src="@drawable/ic_profile" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView android:tag="current_profile_store"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Loja Av. Paulista"
                    android:textColor="@color/color_on_surface"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView android:tag="current_profile_header_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Milena Souza"
                    android:textColor="@color/color_text_subtitle"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnNotificacoesPromocao"
                android:layout_width="19dp"
                android:layout_height="23dp"
                android:contentDescription="Notificações"
                android:src="@drawable/ic_notification" />
        </LinearLayout>

        <!-- Botão Voltar -->
        <LinearLayout
            android:id="@+id/btnVoltarPromocao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="27dp"
            android:layout_marginTop="32dp"
            android:clickable="true"
            android:contentDescription="Voltar"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerDetalhePromocao">

            <ImageView
                android:layout_width="8dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:rotation="180"
                android:src="@drawable/arrow_right" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Voltar"
                android:textColor="@color/color_on_surface"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Título -->
        <TextView
            android:id="@+id/tvTituloDetalhePromocao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="27dp"
            android:layout_marginTop="16dp"
            android:text="Detalhes da promoção"
            android:textColor="@color/color_on_surface"
            android:textSize="21sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnVoltarPromocao" />

        <!-- Status da solicitação (aparece com micro-animação ao decidir) -->
        <TextView
            android:id="@+id/tvStatusDecisaoPromocao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="27dp"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:minHeight="26dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/tvTituloDetalhePromocao"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvTituloDetalhePromocao" />


        <!-- Card do Produto -->
        <LinearLayout
            android:id="@+id/cardProdutoPromocao"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="27dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="27dp"
            android:background="@drawable/bg_card_summary"
            android:orientation="vertical"
            android:padding="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTituloDetalhePromocao">

            <!-- Linha Nome + Tag Fluxo Baixo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvNomeProdutoPromocao"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Leite Integral UHT 1L"
                    android:textColor="@color/color_on_surface"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tagFluxoBaixoPromocao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_summary"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:text="Fluxo Baixo"
                    android:textColor="@color/color_flow_low_text"
                    android:textSize="9sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCategoriaProdutoPromocao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Laticínios - 25 un"
                android:textColor="@color/color_text_subtitle"
                android:textSize="10sp" />

            <!-- Validade e Vencimento -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Validade"
                        android:textColor="@color/color_text_subtitle"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/tvDataValidadePromocao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="06/08/2026"
                        android:textColor="@color/color_on_surface"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDiasParaVencerPromocao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vence em 2 dias"
                    android:textColor="#7F3AEF"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Informações do Pedido de Promoção -->
        <LinearLayout
            android:id="@+id/areaInformacoesPromocao"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="27dp"
            android:layout_marginTop="28dp"
            android:layout_marginEnd="27dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardProdutoPromocao">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Desconto sugerido"
                    android:textColor="@color/color_on_surface"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvDescontoSugerido"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15%"
                    android:textColor="@color/color_on_surface"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Duração"
                    android:textColor="@color/color_on_surface"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvDuracaoPromocao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="7 dias"
                    android:textColor="@color/color_on_surface"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/manager_reason_label"
                android:textColor="@color/color_on_surface"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvMotivoPromocao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/manager_not_informed"
                android:textColor="@color/color_text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Botões de Ação: Aprovar e Reprovar -->
        <LinearLayout
            android:id="@+id/areaBotoesAcaoPromocao"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="27dp"
            android:layout_marginTop="40dp"
            android:layout_marginEnd="27dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/areaInformacoesPromocao">

            <TextView
                android:id="@+id/managerReviewNotice"
                android:tag="current_manager_detail_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:saveEnabled="false"
                android:text="@string/manager_request_review_notice"
                android:textColor="@color/color_text_subtitle"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Decisão final: bloqueia novas ações -->
            <LinearLayout
                android:id="@+id/cardDecisaoPromocao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_card_summary"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvRotuloJustificativaPromocao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/manager_decision_justification_label"
                    android:textColor="@color/color_text_label"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvJustificativaDecisaoPromocao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/color_on_surface"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/manager_locked_notice"
                    android:textColor="@color/color_text_muted"
                    android:textSize="11sp" />
            </LinearLayout>


            <Button
                android:id="@+id/btnAprovarPromocao"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_btn_decision_approve"
                android:stateListAnimator="@animator/press_scale"
                android:text="@string/manager_approve"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnReprovarPromocao"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_btn_decision_reject"
                android:stateListAnimator="@animator/press_scale"
                android:text="@string/manager_reject"
                android:textAllCaps="false"
                android:textColor="@color/color_on_surface"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
