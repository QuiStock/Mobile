<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/managerRequestCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_request_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="13dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp"
    android:stateListAnimator="@animator/press_scale">

    <ImageView
        android:id="@+id/managerRequestIcon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        tools:src="@drawable/promo" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/managerRequestTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Leite Integral UHT 1L" />

        <TextView
            android:id="@+id/managerRequestSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#BFAFC5"
            android:textSize="11sp"
            tools:text="Promoção · 15% · 7 dias" />
    </LinearLayout>

    <TextView
        android:id="@+id/managerRequestBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="24dp"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textSize="11sp"
        android:textStyle="bold"
        tools:background="@drawable/bg_badge_approved"
        tools:text="Aprovada"
        tools:textColor="#89B751" />

    <TextView
        android:id="@+id/managerRequestAnalyze"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:background="@drawable/bg_btn_decision_approve"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="@string/manager_analyze"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
