<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_petroleo"
    tools:context=".presentation.home.HomeFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ================================================= -->
        <!-- HEADER                                             -->
        <!-- ================================================= -->

        <!-- PERFIL -->
        <ImageButton android:tag="current_profile_photo"
            android:id="@+id/btnPerfil"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="28dp"
            android:background="@android:color/transparent"
            android:contentDescription="Perfil"
            android:padding="0dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_profile"
            app:tint="@color/color_text_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- NOME DA LOJA -->

        <TextView android:tag="current_profile_store"
            android:id="@+id/tvNomeLoja"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:text="Nome da loja"
            android:textColor="@color/color_branco"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/btnThemeToggle"
            app:layout_constraintStart_toEndOf="@id/btnPerfil"
            app:layout_constraintTop_toTopOf="@id/btnPerfil" />

        <!-- USUÁRIO -->

        <TextView android:tag="current_profile_header_name"
            android:id="@+id/tvNomeUsuario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Nome do usuário"
            app:layout_constraintEnd_toStartOf="@id/btnThemeToggle"
            android:layout_marginEnd="12dp"
            android:textColor="@color/color_text_subtitle"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="@id/tvNomeLoja"
            app:layout_constraintTop_toBottomOf="@id/tvNomeLoja" />

        <!-- TEMA CLARO/ESCURO -->
        <ImageButton
            android:id="@+id/btnThemeToggle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_circle_button"
            android:contentDescription="@string/theme_toggle"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_theme_toggle"
            app:tint="@color/color_text_title"
            app:layout_constraintBottom_toBottomOf="@id/btnPerfil"
            app:layout_constraintEnd_toStartOf="@id/btnNotificacoes"
            app:layout_constraintTop_toTopOf="@id/btnPerfil" />

        <!-- NOTIFICAÇÕES -->
        <ImageButton
            android:id="@+id/btnNotificacoes"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_circle_button"
            android:contentDescription="Notificações"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_notification"
            app:tint="@color/color_text_title"
            app:layout_constraintBottom_toBottomOf="@id/btnPerfil"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnPerfil" />

        <!-- ================================================= -->
        <!-- SAUDAÇÃO                                           -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvSaudacao"
            android:tag="current_profile_greeting"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="24dp"
            android:text="Olá, usuário!"
            android:textColor="@color/color_text_title"
            android:textSize="26sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnPerfil" />

        <!-- ================================================= -->
        <!-- TRÊS CARDS DE RESUMO                               -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/containerResumo"
            android:layout_width="0dp"
            android:layout_height="146dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="24dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSaudacao">

            <!-- CARD ESQUERDA: AÇÕES ATIVAS (DESTACADO EM VIOLETA) -->
            <LinearLayout
                android:id="@+id/cardAcoes"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="10dp"
                android:layout_weight="1.05"
                android:background="@drawable/bg_card_active"
                android:gravity="bottom|start"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:text="Ações ativas"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="normal" />

                <TextView
                    android:id="@+id/tvNumeroAcoes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/summary_unavailable"
                    android:textColor="@color/white"
                    android:textSize="38sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- COLUNA DIREITA: DOIS CARDS EMPILHADOS -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- CARD 1: VENCIMENTO CURTO -->
                <LinearLayout
                    android:id="@+id/cardVencimento"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_summary_item"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp">

                    <TextView
                        android:id="@+id/tvNumeroVencimento"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="30dp"
                        android:text="@string/summary_unavailable"
                        android:textColor="@color/color_text_title"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_dot_yellow" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Vencimento&#10;curto"
                        android:textColor="@color/color_text_subtitle"
                        android:textSize="12sp"
                        android:lineSpacingExtra="1dp" />
                </LinearLayout>

                <!-- CARD 2: RUPTURA E EXCESSO -->
                <LinearLayout
                    android:id="@+id/cardRuptura"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_summary_item"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp">

                    <TextView
                        android:id="@+id/tvNumeroRuptura"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="30dp"
                        android:text="@string/summary_unavailable"
                        android:textColor="@color/color_text_title"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_dot_pink" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Ruptura e&#10;excesso"
                        android:textColor="@color/color_text_subtitle"
                        android:textSize="12sp"
                        android:lineSpacingExtra="1dp" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/summaryFeedback"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/containerResumo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <ProgressBar
                android:id="@+id/summaryProgress"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:visibility="gone"
                android:contentDescription="@string/summary_loading" />
            <TextView
                android:id="@+id/summaryMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/color_branco"
                android:visibility="gone" />
            <TextView
                android:id="@+id/summaryStale"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/color_branco"
                android:visibility="gone" />
            <TextView
                android:id="@+id/summaryPersistence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/summary_persistence_failed"
                android:textColor="@color/color_branco"
                android:visibility="gone" />
            <Button
                android:id="@+id/summaryRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/summary_retry"
                android:visibility="gone" />
            <Button
                android:id="@+id/summaryLogout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/summary_logout"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ================================================= -->
        <!-- ALERTS TITLE                                      -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvTituloAlertas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:text="@string/home_alerts_title"
            android:textColor="@color/color_text_title"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/summaryFeedback" />

        <!-- ================================================= -->
        <!-- LISTA DE ALERTAS                                   -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/alertsSection"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="24dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTituloAlertas">

            <TextView
                android:id="@+id/managerHomeNotice"
                android:tag="current_manager_home_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_alert"
                android:lineSpacingExtra="2dp"
                android:padding="16dp"
                android:saveEnabled="false"
                android:text="@string/home_alerts_manager_notice"
                android:textColor="@color/color_text_subtitle"
                android:textSize="12sp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/alertsProgress"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="@string/home_alerts_loading" />

            <TextView
                android:id="@+id/alertsMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:background="@drawable/bg_alert"
                android:padding="16dp"
                android:textColor="@color/color_text_subtitle"
                android:textSize="13sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/alertsRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/home_alerts_retry"
                android:textAllCaps="false"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAlertas"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="16dp"
                tools:listitem="@layout/item_alerta" />
        </LinearLayout>

        <!-- ================================================= -->
        <!-- BOTTOM NAVIGATION                                 -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/bottomNavigation"
            android:layout_width="0dp"
            android:layout_height="@dimen/nav_bar_height"
            android:background="@color/color_petroleo"
            android:gravity="center"
            android:orientation="horizontal"
            android:weightSum="5"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <!-- HOME -->
            <ImageButton
                android:id="@+id/btnHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="Início"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_home_active" />

            <!-- INTERFERENCES -->
            <ImageButton
                android:id="@+id/btnMovimentacoes"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="Movimentações"
                android:paddingTop="17dp"
                android:paddingBottom="17dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_interferences" />

            <!-- EMPLOYEES -->
            <ImageButton
                android:id="@+id/btnFuncionarios"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="Funcionários"
                android:paddingTop="17dp"
                android:paddingBottom="17dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_employee" />

            <!-- NOTIFICATIONS -->
            <ImageButton
                android:id="@+id/btnProdutosBottom"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="Controle de produtos"
                android:paddingTop="17dp"
                android:paddingBottom="17dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_product_control" />

            <!-- CHATBOT -->
            <ImageButton
                android:id="@+id/btnFolha"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="Chatbot"
                android:paddingTop="17dp"
                android:paddingBottom="17dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_chatbot" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>



