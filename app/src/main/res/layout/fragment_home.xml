<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_petroleo"
    tools:context=".presentation.home.HomeFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ================================================= -->
        <!-- HEADER                                             -->
        <!-- ================================================= -->

        <!-- PERFIL -->
        <ImageButton
            android:id="@+id/btnPerfil"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="28dp"
            android:background="@android:color/transparent"
            android:contentDescription="Perfil"
            android:padding="0dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_profile"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- NOME DA LOJA -->
        <TextView
            android:id="@+id/tvNomeLoja"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Nome da loja"
            android:textColor="@color/color_branco"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/btnPerfil"
            app:layout_constraintTop_toTopOf="@id/btnPerfil" />

        <!-- USUÁRIO -->
        <TextView
            android:id="@+id/tvNomeUsuario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nome do usuário"
            android:textColor="#BFAFC5"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="@id/tvNomeLoja"
            app:layout_constraintTop_toBottomOf="@id/tvNomeLoja" />

        <!-- NOTIFICAÇÕES -->
        <ImageButton
            android:id="@+id/btnNotificacoes"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="24dp"
            android:background="@android:color/transparent"
            android:contentDescription="Notificações"
            android:padding="0dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_notification"
            app:layout_constraintBottom_toBottomOf="@id/btnPerfil"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnPerfil" />

        <!-- ================================================= -->
        <!-- SAUDAÇÃO                                           -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvSaudacao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:text="Olá, usuário!"
            android:textColor="#E8D2F0"
            android:textSize="26sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnPerfil" />

        <!-- ================================================= -->
        <!-- TRÊS CARDS DE RESUMO                               -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/containerResumo"
            android:layout_width="0dp"
            android:layout_height="115dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="24dp"
            android:orientation="horizontal"
            android:weightSum="3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSaudacao">

            <!-- CARD 1 -->
            <LinearLayout
                android:id="@+id/cardVencimento"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_interference_category"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:id="@+id/tvNumeroVencimento"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3"
                    android:textColor="#E8D2F0"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Vencimento&#10;curto"
                    android:textColor="#C7B7CC"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- CARD 2 -->
            <LinearLayout
                android:id="@+id/cardRuptura"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_interference_category"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:id="@+id/tvNumeroRuptura"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2"
                    android:textColor="#E8D2F0"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Ruptura/&#10;Excesso"
                    android:textColor="#C7B7CC"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- CARD 3 -->
            <LinearLayout
                android:id="@+id/cardAcoes"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_active"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:id="@+id/tvNumeroAcoes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4"
                    android:textColor="@color/color_branco"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Ações ativas"
                    android:textColor="#E8D2F0"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ================================================= -->
        <!-- ALERTS TITLE                                      -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvTituloAlertas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:text="Alertas prioritários"
            android:textColor="#E8D2F0"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/containerResumo" />

        <!-- ================================================= -->
        <!-- LISTA DE ALERTAS                                   -->
        <!-- ================================================= -->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAlertas"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="24dp"
            android:clipToPadding="false"
            android:paddingBottom="16dp"
            app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTituloAlertas"
            tools:listitem="@layout/item_alerta" />

        <!-- ================================================= -->
        <!-- BOTTOM NAVIGATION                                 -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/bottomNavigation"
            android:layout_width="0dp"
            android:layout_height="@dimen/nav_bar_height"
            android:background="@color/color_petroleo"
            android:gravity="center"
            android:orientation="horizontal"
            android:weightSum="5"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <!-- HOME -->
            <ImageButton
                android:id="@+id/btnHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="Início"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_home_active" />

            <!-- INTERFERENCES -->
            <ImageButton
                android:id="@+id/btnMovimentacoes"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="Movimentações"
                android:paddingTop="17dp"
                android:paddingBottom="17dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_interferences" />

            <!-- EMPLOYEES -->
            <ImageButton
                android:id="@+id/btnFuncionarios"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="Funcionários"
                android:paddingTop="17dp"
                android:paddingBottom="17dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_employee" />

            <!-- NOTIFICATIONS -->
            <ImageButton
                android:id="@+id/btnNotificacoesBottom"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="Notificações"
                android:paddingTop="17dp"
                android:paddingBottom="17dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_notification" />

            <!-- CHATBOT -->
            <ImageButton
                android:id="@+id/btnFolha"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="Chatbot"
                android:paddingTop="17dp"
                android:paddingBottom="17dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_chatbot" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
