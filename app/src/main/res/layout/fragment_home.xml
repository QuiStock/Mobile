<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#11061F"
    tools:context=".presentation.home.HomeFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ================================================= -->
        <!-- HEADER                                             -->
        <!-- ================================================= -->

        <!-- PERFIL -->

        <ImageButton
            android:id="@+id/btnPerfil"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="28dp"
            android:layout_marginTop="52dp"
            android:background="@android:color/transparent"
            android:contentDescription="Perfil"
            android:padding="0dp"
            android:src="@drawable/ic_profile"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- NOME DA LOJA -->

        <TextView
            android:id="@+id/tvNomeLoja"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="Nome da loja"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/btnPerfil"
            app:layout_constraintTop_toTopOf="@id/btnPerfil" />

        <!-- USUÁRIO -->

        <TextView
            android:id="@+id/tvNomeUsuario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nome do usuário"
            android:textColor="#BFAFC5"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="@id/tvNomeLoja"
            app:layout_constraintTop_toBottomOf="@id/tvNomeLoja" />

        <!-- NOTIFICAÇÕES -->

        <ImageButton
            android:id="@+id/btnNotificacoes"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="42dp"
            android:background="@android:color/transparent"
            android:contentDescription="Notificações"
            android:padding="0dp"
            android:src="@drawable/ic_notification"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnPerfil" />


        <!-- ================================================= -->
        <!-- SAUDAÇÃO                                           -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvSaudacao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="29dp"
            android:layout_marginTop="45dp"
            android:text="Olá, usuário!"
            android:textColor="#E8D2F0"
            android:textSize="27sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnPerfil" />


        <!-- ================================================= -->
        <!-- TRÊS CARDS                                         -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/containerResumo"
            android:layout_width="0dp"
            android:layout_height="130dp"
            android:layout_marginStart="27dp"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="27dp"
            android:orientation="horizontal"
            android:weightSum="3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSaudacao">


            <!-- CARD 1 -->

            <LinearLayout
                android:id="@+id/cardVencimento"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_interference_category"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:id="@+id/tvNumeroVencimento"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#E8D2F0"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Vencimento&#10;curto"
                    android:textColor="#C7B7CC"
                    android:textSize="11sp" />

            </LinearLayout>


            <!-- CARD 2 -->

            <LinearLayout
                android:id="@+id/cardRuptura"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_interference_category"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:id="@+id/tvNumeroRuptura"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#E8D2F0"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Ruptura/&#10;Excesso"
                    android:textColor="#C7B7CC"
                    android:textSize="11sp" />

            </LinearLayout>


            <!-- CARD 3 -->

            <LinearLayout
                android:id="@+id/cardAcoes"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_active"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:id="@+id/tvNumeroAcoes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Ações ativas"
                    android:textColor="#E8D2F0"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>


        <TextView
            android:id="@+id/tvIndicatorsStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="27dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="27dp"
            android:accessibilityLiveRegion="polite"
            android:textColor="#E8D2F0"
            android:textSize="13sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/containerResumo" />

        <Button
            android:id="@+id/btnRetryIndicators"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="27dp"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/home_indicators_retry"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvIndicatorsStatus" />

        <!-- ================================================= -->
        <!--  ALERTS TITLES                                   -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvTituloAlertas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="35dp"
            android:layout_marginTop="36dp"
            android:text="Alertas prioritários"
            android:textColor="#E8D2F0"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnRetryIndicators" />


        <!-- ================================================= -->
        <!-- LISTA DE ALERTAS                                   -->
        <!-- ================================================= -->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAlertas"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="31dp"
            android:layout_marginTop="17dp"
            android:layout_marginEnd="31dp"
            android:clipToPadding="false"
            android:paddingBottom="15dp"
            app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTituloAlertas"
            tools:listitem="@layout/item_alerta" />


        <!-- ================================================= -->
        <!-- BOTTOM NAVIGATION                                 -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/bottomNavigation"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:background="#11061F"
            android:gravity="center"
            android:orientation="horizontal"
            android:weightSum="4"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">


            <!-- HOME -->

            <ImageButton
                android:id="@+id/btnHome"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="Início"
                android:padding="0dp"
                android:src="@drawable/ic_home_active" />


            <!-- INTERFERENCES -->

            <ImageButton
                android:id="@+id/btnMovimentacoes"
                android:layout_width="0dp"
                android:layout_height="25dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="Movimentações"
                android:padding="0dp"
                android:src="@drawable/ic_interferences" />


            <!-- PRODUCT CONTROL -->

            <ImageButton
                android:id="@+id/btnProdutos"
                android:layout_width="0dp"
                android:layout_height="25dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="Produtos"
                android:padding="0dp"
                android:src="@drawable/ic_product_control" />


            <!-- CHATBOT -->

            <ImageButton
                android:id="@+id/btnFolha"
                android:layout_width="0dp"
                android:layout_height="25dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="Outra seção"
                android:padding="0dp"
                android:src="@drawable/ic_chatbot" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
