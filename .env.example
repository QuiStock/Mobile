# Base URL da API interna usada pelo Retrofit.
#
# Use um destes valores na variável de ambiente do processo de build:
# - Emulador Android acessando o backend local:
#   BACKEND_BASE_URL=http://10.0.2.2:8080/api/
# - Backend publicado:
#   BACKEND_BASE_URL=https://api.example.com/api/
#
# A URL deve começar com http:// ou https:// e terminar com uma barra (/).
# O Gradle não lê este arquivo automaticamente. Em desenvolvimento, configure a
# variável no terminal ou na configuração de execução do Android Studio. Ambientes
# remotos e pipelines podem injetar BACKEND_BASE_URL diretamente no processo do build.
# Se ela não estiver definida, o dummy value do config.xml será mantido.
BACKEND_BASE_URL=https://api.example.com/api/
